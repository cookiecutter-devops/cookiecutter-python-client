_registryclient_bash_completion()
{
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    opts="$(registryclient bash_completion)"

    COMPLETION_CACHE=~/.registryclient/*/*-cache
    opts+=" "$(cat $COMPLETION_CACHE 2> /dev/null | tr '\n' ' ')

    COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
}
complete -F _registryclient_bash_completion registryclient
